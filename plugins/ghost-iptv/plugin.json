{
  "id": "com.ghost.iptv",
  "name": "Ghost IPTV - Alazterflix Addon",
  "version": "2.5.0",
  "description": "Plugin e Addon oficial Ghost IPTV integrado ao Alazterflix e Stremio. Traz a experiência completa de TV ao Vivo para PC com conversor de Addons Stremio, EPG perpétuo e atualização automática via GitHub oficial (alazter/ghost-iptv).",
  "author": "Alazter & Ghost Labs",
  "type": "media",
  "entrypoint": "index.js",
  "style": "theme.css",
  "icon": "faTowerBroadcast",
  "homepage": "https://github.com/alazter/ghost-iptv",
  "repository": "alazter/ghost-iptv",
  "permissions": [
    "ui:inject-css",
    "ui:widgets",
    "network",
    "storage",
    "media"
  ],
  "allowedDomains": [
    "*.strem.io",
    "v3-cinemeta.strem.io",
    "*.strem.fun",
    "*.elfhosted.com",
    "*.baby-beamup.club",
    "api.github.com",
    "github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "127.0.0.1",
    "localhost",
    "*.m3u8",
    "*.ts",
    "*.playerembcanais.com",
    "meufutebol.oneplayhd.com",
    "*.playerembedcanais.site",
    "*.cdn8embed.xyz",
    "*.cdn10embed.xyz"
  ],
  "tier": 1,
  "minGhostVersion": "0.1.0"
}